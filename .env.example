# =====================================================================
# Copia este archivo como .env.local (en local) o añade estas variables
# en Vercel → Project → Settings → Environment Variables.
# Las que empiezan por NEXT_PUBLIC_ son visibles en el navegador (no son secretas).
# =====================================================================

# URL pública de la web, sin barra final (se usa en correos, Stripe y SEO)
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com

# --- Supabase (obligatorio) --- Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA: nunca la compartas ni la pongas con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Seguridad (obligatorio) ---
# Cadena aleatoria larga para firmar la cookie del formulario inicial.
# Genera una con: openssl rand -hex 32
LEAD_COOKIE_SECRET=

# --- Correo con Resend (opcional, recomendado) --- https://resend.com
# Sin esto, las solicitudes y reservas se guardan igual, pero NO se envían correos
# (el panel lo indica en cada reserva).
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Webs que venden <hola@tu-dominio.com>"
EMAIL_FROM=
# Dónde quieres recibir los avisos de nuevas solicitudes, reservas y pagos
ADMIN_NOTIFY_EMAIL=

# --- Stripe (opcional) --- https://dashboard.stripe.com/apikeys
# Usa primero las claves de prueba (sk_test_...). Sin esto, la contratación se
# registra como "pago pendiente de activar" y no se cobra nada.
STRIPE_SECRET_KEY=
# Stripe → Developers → Webhooks → endpoint https://tu-dominio.com/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Formulario obligatorio antes de entrar (opcional) ---
# Pon "off" para desactivar temporalmente el formulario obligatorio.
LEAD_GATE=on
