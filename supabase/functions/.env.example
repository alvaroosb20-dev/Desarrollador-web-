# =====================================================================
# SECRETOS DE LAS EDGE FUNCTIONS (nunca van en la carpeta public/)
# Súbelos con:  supabase secrets set --env-file supabase/functions/.env
# o en Supabase → Edge Functions → Secrets.
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY los pone Supabase solo.
# =====================================================================

# Dirección pública de la web, sin barra final (enlaces de correos, Stripe y CORS)
SITE_URL=https://tu-dominio.com
# Otros orígenes permitidos, separados por comas (opcional; p. ej. la versión con www)
ALLOWED_ORIGINS=https://www.tu-dominio.com

# Cadena aleatoria de 32+ caracteres: firma el comprobante del formulario inicial
# Genérala con:  openssl rand -hex 32
LEAD_SECRET=

# --- Correo con Resend (recomendado) --- https://resend.com
RESEND_API_KEY=
EMAIL_FROM=Webs que venden <hola@tu-dominio.com>
ADMIN_NOTIFY_EMAIL=tu-correo@tu-dominio.com

# --- Stripe (opcional) --- empieza con las claves de prueba sk_test_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
